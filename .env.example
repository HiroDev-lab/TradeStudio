# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis no
# projeto da Vercel (produção). Nunca commite o arquivo preenchido.

# ── Públicas: vão para o navegador e também são lidas pelo servidor ──────────
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Segredos: só servidor. NUNCA usar o prefixo VITE_ aqui ───────────────────
# Supabase > Project Settings > API > service_role (ignora a RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Chaves padrão da empresa, usadas quando o agente não tem chave própria.
# Basta uma. OpenRouter: https://openrouter.ai/keys — Gemini: https://aistudio.google.com/apikey
# — OpenAI: https://platform.openai.com/api-keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Opcionais ────────────────────────────────────────────────────────────────
# Agente sem modelo selecionado usa o primeiro provedor que tiver chave acima
# (ou o DEFAULT_PROVIDER) e o modelo padrão dele.
# DEFAULT_PROVIDER=openrouter
# OPENROUTER_DEFAULT_MODEL=modelo-principal,modelo-reserva   (lista em ordem de preferência)
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# OPENAI_DEFAULT_MODEL=gpt-4o-mini

# "true" mostra o botão "Entrar com Google" (exige o provedor Google
# configurado em Supabase > Authentication > Providers).
# VITE_GOOGLE_LOGIN=true

# Outras origens autorizadas a chamar /api/* pelo navegador (CORS), separadas
# por vírgula. O domínio da própria Vercel e o localhost já são aceitos.
# APP_ORIGINS=https://meu-dominio.com.br
